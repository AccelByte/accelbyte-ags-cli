      "roleId": "b3f1c2d4-5e6a-4789-9abc-1d2e3f4a5b6c",
      "roleName": "Support Agent",
      "adminRole": false,
      "isWildcard": false,
      "permissions": [
        { "action": 2, "resource": "NAMESPACE:demo:USER" }
      ]
    }
  }
]
