[
  {
    "method": "POST",
    "path": "/iam/v3/oauth/token",
    "status": 200,
    "delay": 1.0,
    "body": { "access_token": "demo-token", "token_type": "Bearer", "expires_in": 3600 }
  },

  {
    "method": "POST",
    "path": "/iam/v4/admin/roles/{roleId}/permissions",
    "status": 200,
